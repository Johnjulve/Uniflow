# Django Core Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL default)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uniflow

# CORS Configuration (Vite frontend default)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business & Installation Settings
UNIFLOW_ALLOW_NEGATIVE_STOCK=False
